# Bazada maxfiy ma'lumotlarni (masalan Billz API kalitlarini) shifrlab
# saqlash uchun asosiy kalit. Yaratish:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DIQQAT: bu kalitni yo'qotmang va git'ga commit qilmang — yo'qolsa,
# shifrlangan Billz kalitlarini qayta ochib bo'lmaydi.
ENCRYPTION_KEY=

# Billz.io (POS/ombor tizimi) — mahsulotlarni avtomatik sinxronlash.
# DIQQAT: har bir do'konning O'ZINING Billz API kaliti bor (Billz'da har
# bir do'kon alohida akkaunt) — shuning uchun kalit bu yerda emas, botning
# ichida (Admin panel -> 🏪 Do'konlar -> 🔗 Billz bilan bog'lash) har bir
# do'kon uchun alohida kiritiladi.
BILLZ_SYNC_ENABLED=false
BILLZ_SYNC_INTERVAL_MINUTES=10
# Rasmlarni Telegram'ga yuklab, file_id olish uchun ishlatiladigan chat
# (bo'sh qoldirilsa, birinchi SUPER_ADMIN_IDS ishlatiladi)
BILLZ_IMAGE_STORAGE_CHAT_ID=

